# Application Environment
MIX_ENV=dev

# Database Configuration
DATABASE_URL=ecto://postgres:postgres@localhost/myapp_dev

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# YouTube API Configuration
YOUTUBE_API_KEY=your_youtube_api_key

# TikTok API Configuration
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# Instagram Configuration
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_REDIRECT_URI=http://localhost:4000/auth/instagram/callback

# Twitter API Configuration
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_REDIRECT_URI=http://localhost:4000/auth/twitter/callback

# Thread API Configuration
THREAD_API_ACCESS_TOKEN=your_thread_api_access_token

# Sentry Error Monitoring
# Required for error tracking and monitoring
# Get this from your Sentry project settings at https://sentry.io
# Format: https://[public_key]@[organization].ingest.sentry.io/[project_id]
SENTRY_DSN=https://your_public_key@your_project.ingest.sentry.io/your_project_id
