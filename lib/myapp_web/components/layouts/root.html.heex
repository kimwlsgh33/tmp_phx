<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable] h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix=" · Main">
      {assigns[:page_title] || "ingrey"}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js">
    </script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
    <script>
      if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body
    class="h-full flex flex-col bg-white dark:bg-black text-gray-900 dark:text-gray-300"
    data-logged-in={if assigns[:current_user], do: "true", else: "false"}
  >
    <!-- Navigation -->
    <header class="bg-white dark:bg-dark-950 dark:border-dark-800 z-1">
      <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" aria-label="Top">
        <div class="flex w-full items-center justify-between border-b border-gray-200 py-3 lg:border-none">
          <div class="flex items-center">
            <a href={~p"/"} class="flex items-center">
              <img src="/images/logos/real_final.svg" alt="CreatorSync Logo" class="h-10 w-auto emerald-500 dark:indigo-400" loading="lazy" />
              <span class="ml-2 text-xl font-bold text-gray-900 dark:text-gray-300">ingrey</span>
            </a>
          </div>
          <div class="flex items-center">
            <div class="hidden space-x-8 lg:block">
            <a
                href={~p"/dashboard"}
                class={"text-base font-medium #{if @conn.request_path == "/dashboard", do: "text-[#FD4F00] dark:text-[#FD4F00]", else: "text-gray-900 dark:text-gray-300"} hover:text-gray-500 dark:hover:text-gray-400 transition duration-200"}
              >
                Dashboard
              </a>
              <a
                href={~p"/new_dashboard"}
                class={"text-base font-medium #{if @conn.request_path == "/new_dashboard", do: "text-[#FD4F00] dark:text-[#FD4F00]", else: "text-gray-900 dark:text-gray-300"} hover:text-gray-500 dark:hover:text-gray-400 transition duration-200"}
              >
                Simple Dashboard
              </a>
              
              <a
                href={~p"/marketing/pricing"}
                class={"text-base font-medium #{if @conn.request_path == "/marketing/pricing", do: "text-[#FD4F00] dark:text-[#FD4F00]", else: "text-gray-900 dark:text-gray-300"} hover:text-gray-500 dark:hover:text-gray-400 transition duration-200"}
              >
                Pricing
              </a>
              <a
                href={~p"/marketing/company"}
                class={"text-base font-medium #{if @conn.request_path == "/marketing/company", do: "text-[#FD4F00] dark:text-[#FD4F00]", else: "text-gray-900 dark:text-gray-300"} hover:text-gray-500 dark:hover:text-gray-400 transition duration-200"}
              >
                Company
              </a>
            </div>
            <div class="hidden lg:block h-5 w-px bg-gray-300 dark:bg-gray-700 mx-4"></div>
            <div class="space-x-4">
              <%= if assigns[:current_user] do %>
                <div
                  x-data="{ open: false, switchDropdownOpen: false }"
                  class="relative flex items-center gap-2"
                >
                  
<!-- User Avatar Button -->
                  <button
                    type="button"
                    class="relative flex items-center gap-2 rounded-full bg-orange-600 text-sm focus:outline-none focus:ring-2 focus:ring-primary-600 focus:ring-offset-2"
                    id="user-menu-button"
                    aria-expanded="false"
                    aria-haspopup="true"
                    @click="open = !open; switchDropdownOpen = false"
                    @keydown.escape.window="open = false"
                  >
                    <%= if @current_user.avatar_url do %>
                      <img
                        class="h-8 w-8 rounded-full"
                        src={@current_user.avatar_url}
                        onerror="this.onerror=null; this.src='/images/default_avatar.svg';"
                        alt="Profile picture"
                      />
                    <% else %>
                      <div class="h-8 w-8 rounded-full bg-orange-600 flex items-center justify-center text-gray-300 font-bold">
                        {String.first(@current_user.email)}
                      </div>
                    <% end %>
                  </button>
                  
<!-- Overlay -->
                  <div
                    x-show="open"
                    x-transition:enter="transition ease-out duration-300"
                    x-transition:enter-start="opacity-0"
                    x-transition:enter-end="opacity-100"
                    x-transition:leave="transition ease-in duration-200"
                    x-transition:leave-start="opacity-100"
                    x-transition:leave-end="opacity-0"
                    class="fixed inset-0 bg-black bg-opacity-50 z-40"
                    @click="open = false"
                    style="display: none;"
                  >
                  </div>
                  
<!-- Profile Slide-out Menu -->
                  <div
                    x-show="open"
                    x-transition:enter="transition ease-out duration-300"
                    x-transition:enter-start="transform opacity-0 translate-x-full"
                    x-transition:enter-end="transform opacity-100 translate-x-0"
                    x-transition:leave="transition ease-in duration-200"
                    x-transition:leave-start="transform opacity-100 translate-x-0"
                    x-transition:leave-end="transform opacity-0 translate-x-full"
                    class="fixed inset-y-0 right-0 w-80 bg-white dark:bg-black border-l border-orange-800 rounded-l-2xl shadow-xl z-50 overflow-y-auto"
                    role="menu"
                    aria-orientation="vertical"
                    aria-labelledby="user-menu-button"
                    tabindex="-1"
                    style="display: none;"
                  >
                    <div class="py-5 border-b border-gray-200 dark:border-zinc-700 relative">
                      <div class="flex justify-start items-center px-6">
                        <div class="w-6 flex justify-center items-center mr-3">
                          <%= if @current_user.avatar_url do %>
                            <img
                              class="h-8 w-8 rounded-full"
                              src={@current_user.avatar_url}
                              onerror="this.onerror=null; this.src='/images/default_avatar.svg';"
                              alt="Profile picture"
                            />
                          <% else %>
                            <div class="h-8 w-8 rounded-full bg-blue-600 flex items-center justify-center text-gray-300 font-bold text-lg">
                              {String.first(@current_user.email)}
                            </div>
                          <% end %>
                        </div>
                        <div class="flex-1 flex items-center justify-between">
                          <p class="text-sm font-medium text-gray-600 dark:text-gray-400">{@current_user.email}</p>
                          <div class="flex items-center space-x-2">
                            <button
                              type="button"
                              @click="switchDropdownOpen = !switchDropdownOpen"
                              @keydown.escape.window="switchDropdownOpen = false"
                              class="p-1 rounded-full hover:bg-gray-100 dark:hover:bg-zinc-800 text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-300 transition-colors relative"
                              aria-expanded="false"
                              aria-haspopup="true"
                              aria-label="Switch account"
                            >
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-4 w-4"
                                viewBox="0 0 20 20"
                                fill="currentColor"
                              >
                                <path d="M8 5a1 1 0 100 2h5.586l-1.293 1.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L13.586 5H8zM12 15a1 1 0 100-2H6.414l1.293-1.293a1 1 0 10-1.414-1.414l-3 3a1 1 0 000 1.414l3 3a1 1 0 001.414-1.414L6.414 15H12z" />
                              </svg>
                            </button>
                            <!-- Switch account dropdown overlay -->
                            <div
                              x-show="switchDropdownOpen"
                              x-transition:enter="transition ease-out duration-300"
                              x-transition:enter-start="opacity-0"
                              x-transition:enter-end="opacity-100"
                              x-transition:leave="transition ease-in duration-200"
                              x-transition:leave-start="opacity-100"
                              x-transition:leave-end="opacity-0"
                              class="fixed inset-0 bg-black bg-opacity-50 z-55"
                              @click="switchDropdownOpen = false"
                              style="display: none;"
                            >
                            </div>
                            
<!-- Switch account dropdown menu -->
                            <div
                              x-show="switchDropdownOpen"
                              x-transition:enter="transition ease-out duration-200"
                              x-transition:enter-start="transform opacity-0 scale-95"
                              x-transition:enter-end="transform opacity-100 scale-100"
                              x-transition:leave="transition ease-in duration-150"
                              x-transition:leave-start="transform opacity-100 scale-100"
                              x-transition:leave-end="transform opacity-0 scale-95"
                              class="absolute right-0 mt-3 w-64 origin-top-right rounded-md bg-white dark:bg-zinc-800 shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none z-60 transform -translate-x-10"
                              role="menu"
                              aria-orientation="vertical"
                              aria-labelledby="switch-menu-button"
                              tabindex="-1"
                              style="display: none; top: 40px;"
                            >
                              <div class="py-1">
                                <div class="px-4 py-2 text-xs text-gray-500 border-b border-gray-200 dark:border-zinc-700">
                                  Linked Accounts
                                </div>

                                <%= for linked_account <- Myapp.Accounts.list_linked_accounts(@current_user) do %>
                                  <div class="flex items-center justify-between px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-zinc-700 hover:text-gray-900 dark:hover:text-gray-300 transition-colors">
                                    <div class="flex items-center">
                                      <div class="h-6 w-6 rounded-full bg-blue-600 flex items-center justify-center text-gray-300 font-bold mr-2">
                                        {String.first(linked_account.user.email)}
                                      </div>
                                      <a
                                        href={~p"/users/switch_account/#{linked_account.user.id}"}
                                        class="flex-1 hover:underline"
                                        @click="switchDropdownOpen = false"
                                      >
                                        {linked_account.user.email}
                                      </a>
                                    </div>
                                  </div>
                                <% end %>

                                <div class="border-t border-gray-200 dark:border-zinc-700 mt-1"></div>
                                <a
                                  href={~p"/users/link_account"}
                                  class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-zinc-700 hover:text-gray-900 dark:hover:text-gray-300 transition-colors"
                                  role="menuitem"
                                  tabindex="-1"
                                  id="switch-menu-item-0"
                                  @click="switchDropdownOpen = false"
                                >
                                  <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="w-4 h-5"
                                    viewBox="0 0 24 24"
                                    fill="currentColor"
                                  >
                                    <path d="M12 4a4 4 0 100 8 4 4 0 000-8zm0 10c-4.42 0-8 1.79-8 4v2h9v-2.88c.32-.07.66-.12 1-.12h4v-1c0-2.21-3.58-4-8-4z" />
                                    <path d="M18 14v3h3v2h-3v3h-2v-3h-3v-2h3v-3h2z" />
                                  </svg>
                                  Add Account
                                </a>
                              </div>
                            </div>
                            <button
                              @click="open = !open"
                              class="p-1 rounded-full hover:bg-gray-200 dark:hover:bg-zinc-800 text-gray-700 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-300 transition-colors"
                              aria-label="Close menu"
                            >
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-4 w-4"
                                viewBox="0 0 20 20"
                                fill="currentColor"
                              >
                                <path
                                  fill-rule="evenodd"
                                  d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                                  clip-rule="evenodd"
                                />
                              </svg>
                            </button>
                          </div>
                        </div>
                      </div>
                    </div>
                    <!-- Menu Items -->
                    <div class="p-2">
                      <a
                        href={~p"/users/profile"}
                        class="block px-6 py-3 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-zinc-800 hover:text-gray-900 dark:hover:text-gray-300 transition-colors"
                        role="menuitem"
                      >
                        <div class="flex justify-start items-center">
                          <div class="w-6 flex justify-center items-center mr-3">
                            <svg
                              class="w-5 h-5"
                              xmlns="http://www.w3.org/2000/svg"
                              viewBox="0 0 24 24"
                              fill="currentColor"
                            >
                              <path
                                fill-rule="evenodd"
                                d="M18.685 19.097A9.723 9.723 0 0021.75 12c0-5.385-4.365-9.75-9.75-9.75S2.25 6.615 2.25 12a9.723 9.723 0 003.065 7.097A9.716 9.716 0 0012 21.75a9.716 9.716 0 006.685-2.653zm-12.54-1.285A7.486 7.486 0 0112 15a7.486 7.486 0 015.855 2.812A8.224 8.224 0 0112 20.25a8.224 8.224 0 01-5.855-2.438zM15.75 9a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"
                                clip-rule="evenodd"
                              />
                            </svg>
                          </div>
                          <span class="flex-1">Your Profile</span>
                        </div>
                      </a>
                      <a
                        href={~p"/sns-accounts"}
                        class="block px-6 py-3 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-zinc-800 hover:text-gray-900 dark:hover:text-gray-300 transition-colors"
                        role="menuitem"
                      >
                        <div class="flex justify-start items-center">
                          <div class="w-6 flex justify-center items-center mr-3">
                            <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                            </svg>
                          </div>
                          <span class="flex-1">SNS Accounts</span>
                        </div>
                      </a>
                      <.link
                        href={~p"/users/sign_out"}
                        class="block px-6 py-3 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-zinc-800 hover:text-gray-900 dark:hover:text-gray-300 transition-colors"
                        role="menuitem"
                      >
                        <div class="flex justify-start items-center">
                          <div class="w-6 flex justify-center items-center mr-3">
                            <svg
                              class="w-5 h-5"
                              xmlns="http://www.w3.org/2000/svg"
                              viewBox="0 0 24 24"
                              fill="currentColor"
                            >
                              <path
                                fill-rule="evenodd"
                                d="M7.5 3.75A1.5 1.5 0 006 5.25v13.5a1.5 1.5 0 001.5 1.5h6a1.5 1.5 0 001.5-1.5V15a.75.75 0 011.5 0v3.75a3 3 0 01-3 3h-6a3 3 0 01-3-3V5.25a3 3 0 013-3h6a3 3 0 013 3V9A.75.75 0 0115 9V5.25a1.5 1.5 0 00-1.5-1.5h-6zm10.72 4.72a.75.75 0 011.06 0l3 3a.75.75 0 010 1.06l-3 3a.75.75 0 11-1.06-1.06l1.72-1.72H9a.75.75 0 010-1.5h10.94l-1.72-1.72a.75.75 0 010-1.06z"
                                clip-rule="evenodd"
                              />
                            </svg>
                          </div>
                          <span class="flex-1">Sign Out</span>
                        </div>
                      </.link>
                      <div class="border-t border-zinc-700 mt-2 pt-2">
                        <button
                          id="theme-toggle"
                          phx-hook="ThemeToggle"
                          class="w-full flex items-center px-6 py-3 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-zinc-800 hover:text-gray-900 dark:hover:text-gray-300 transition-colors"
                          aria-label="Toggle dark mode"
                        >
                          <div class=" flex justify-center items-center mr-3">
                            <svg
                              class="theme-toggle-dark-icon hidden w-5 h-5"
                              fill="currentColor"
                              viewBox="0 0 20 20"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z">
                              </path>
                            </svg>
                            <svg
                              class="theme-toggle-light-icon hidden w-5 h-5"
                              fill="currentColor"
                              viewBox="0 0 20 20"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path
                                d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
                                fill-rule="evenodd"
                                clip-rule="evenodd"
                              >
                              </path>
                            </svg>
                          </div>
                          <span class="flex-1">Toggle Dark Mode</span>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              <% else %>
                <.link
                  href={~p"/users/log_in"}
                  class={"text-base font-medium #{if @conn.request_path == "/users/log_in", do: "text-[#FD4F00] dark:text-[#FD4F00]", else: "text-gray-400 dark:text-gray-300"} py-2 text-base font-medium hover:text-gray-300 dark:hover:text-gray-300 transition"}
                >
                  Sign in
                </.link>
              <% end %>
            </div>
          </div>
        </div>
        <div class="flex flex-wrap justify-center space-x-6 py-4 lg:hidden">
          <a
            href={~p"/docs"}
            class={"text-base font-medium #{if @conn.request_path == "/docs", do: "text-gray-300", else: "text-gray-700"} hover:text-blue-600 transition"}
          >
            Documentation
          </a>
          <a
            href={~p"/dashboard"}
            class={"text-base font-medium #{if @conn.request_path == "/dashboard", do: "text-gray-300", else: "text-gray-700"} hover:text-blue-600 transition"}
          >
            Dashboard
          </a>
          <a
            href={~p"/new_dashboard"}
            class={"text-base font-medium #{if @conn.request_path == "/new_dashboard", do: "text-gray-300", else: "text-gray-700"} hover:text-blue-600 transition"}
          >
            Simple Dashboard
          </a>
          <a
            href={~p"/marketing/pricing"}
            class={"text-base font-medium #{if @conn.request_path == "/marketing/pricing", do: "text-gray-300", else: "text-gray-700"} hover:text-blue-600 transition"}
          >
            Pricing
          </a>
          <a
            href={~p"/marketing/features"}
            class={"text-base font-medium #{if @conn.request_path == "/marketing/features", do: "text-gray-300", else: "text-gray-700"} hover:text-blue-600 transition"}
          >
            Features
          </a>
          <a
            href={~p"/marketing/company"}
            class={"text-base font-medium #{if @conn.request_path == "/marketing/company", do: "text-gray-300", else: "text-gray-700"} hover:text-blue-600 transition"}
          >
            Company
          </a>
        </div>
      </nav>
    </header>

    <.flash_group flash={@flash} />
    
<!-- loading spinner -->
    <!-- <div id="global-spinner" class="spinner justify-center items-center"> -->
    <!--   <svg -->
    <!--     width="100" -->
    <!--     height="120" -->
    <!--     viewBox="247 250 404 300" -->
    <!--     fill="none" -->
    <!--     xmlns="http://www.w3.org/2000/svg" -->
    <!--   > -->
    <!--     <path -->
    <!--       d="M421.77,208.95c0-14.67,11.25-55.63-3.12-58.6c-9.97-2.06-17.54,26.02-18.78,36.12   c-1.59,12.97-3.7,39.5-0.88,52.26c1.97,8.91,5.84,31.6,14.79,33.37c8.29,1.64,21.72-14.38,25.89-21.73   c3.77-6.65,9.69-20.91,11.54-28.32c2.38-9.51,7.63-29.2,5.68-38.81c-2.4-11.83-12.04-38.88-23.68-42.07   c-11.05-3.02-32.27,14.56-39.22,23.66c-7.19,9.41-12.55,33.73-12.93,45.56c-0.38,11.82-.71,36.43,4.39,47.1   c3.57,7.47,17.92,17.35,22.73,24.09c4.35,6.1,10.22,20.37,11.22,27.8c5.39,40.08-1.49,121.5-6.32,161.65   c-2,16.6-9.56,66.19-9.56,66.19s-11.49,32.96-17.45,42.89c-3.17,5.28-9.82,20.45-15.78,18.92c-10.61-2.73-13.52-31.99-10.55-42.54   c8.02-28.42,43.16-77.72,61.56-100.81c12.74-15.98,40.18-46.84,49.54-65c13.57-26.34,35.03-113.21,35.03-113.21   s-2.01,88.94-8.86,117.62c-4.86,20.34-24.21,58.24-36,75.52c-5.79,8.49-21.08,22.49-28.08,30.01c-6,6.44-22.58,27.02-22.58,27.02" -->
    <!--       stroke="gray" -->
    <!--       storke-width="10" -->
    <!--     /> -->
    <!--   </svg> -->
    <!-- </div> -->
    
<!-- Main -->
    <main class="flex-1 bg-white dark:bg-black flex flex-col">
      <div class="flex-1 flex flex-col justify-between">
        {@inner_content}
      </div>
    </main>

    <footer class="bg-white dark:bg-black text-gray-700 dark:text-gray-300 py-12 relative mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <!-- Logo and Copyright -->
          <div class="space-y-4">
            <div class="flex items-center">
              <a href={~p"/"} class="flex items-center">
