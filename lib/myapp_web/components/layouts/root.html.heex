<!-- Fixed Position Theme Toggle for all users -->
    <div class="fixed bottom-4 right-4 z-40">
      <button
        id="global-theme-toggle"
        phx-hook="ThemeToggle"
        class="bg-zinc-800 dark:bg-black text-gray-400 hover:text-gray-300 p-3 rounded-full shadow-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-800 focus:ring-white"
        aria-label="Toggle dark mode"
      >
        <svg
          class="theme-toggle-dark-icon hidden w-5 h-5"
          fill="currentColor"
          viewBox="0 0 20 20"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
        </svg>
        <svg
